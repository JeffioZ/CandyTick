<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Both transports receive the same portable projection. -->
    <cloud-backup>
        <include domain="file" path="portable_state.json" />
        <include domain="file" path="app_state.json" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="portable_state.json" />
        <include domain="file" path="app_state.json" />
    </device-transfer>
</data-extraction-rules>
