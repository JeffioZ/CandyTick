<?xml version="1.0" encoding="utf-8"?>
<!-- 回声前景 · 深夜绿砖版：外缘严格收在自适应图标安全区（半径 33dp）内 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 外涟漪：外缘 29+2.5=31.5 ≤ 33 -->
    <path
        android:pathData="M54,54 m-29,0 a29,29 0 1,1 58,0 a29,29 0 1,1 -58,0"
        android:fillColor="#00000000"
        android:strokeColor="#B34ADE9E"
        android:strokeWidth="5" />

    <!-- 内涟漪（强） -->
    <path
        android:pathData="M54,54 m-20.5,0 a20.5,20.5 0 1,1 41,0 a20.5,20.5 0 1,1 -41,0"
        android:fillColor="#00000000"
        android:strokeColor="#F54ADE9E"
        android:strokeWidth="7.5" />

    <!-- 荧光糖珠 -->
    <path android:pathData="M54,54 m-11,0 a11,11 0 1,1 22,0 a11,11 0 1,1 -22,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="51.4"
                android:centerY="50"
                android:gradientRadius="12.5">
                <item android:offset="0" android:color="#FFD6FBEF" />
                <item android:offset="0.4" android:color="#FF6FE6B2" />
                <item android:offset="0.75" android:color="#FF2FB683" />
                <item android:offset="1" android:color="#FF22A173" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 底部微反光 -->
    <path
        android:pathData="M49,60.8 a5,2.4 0 1,0 10,0 a5,2.4 0 1,0 -10,0"
        android:fillColor="#597CE8BC" />
</vector>
