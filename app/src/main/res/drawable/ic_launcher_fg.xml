<?xml version="1.0" encoding="utf-8"?>
<!-- 回声前景 · 深夜绿砖版：外缘 28dp（安全区 33dp 留 5dp 呼吸），与开屏几何一致 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 外涟漪 -->
    <path
        android:pathData="M54,54 m-26,0 a26,26 0 1,1 52,0 a26,26 0 1,1 -52,0"
        android:fillColor="#00000000"
        android:strokeColor="#B34ADE9E"
        android:strokeWidth="4.5" />

    <!-- 内涟漪（强） -->
    <path
        android:pathData="M54,54 m-18.5,0 a18.5,18.5 0 1,1 37,0 a18.5,18.5 0 1,1 -37,0"
        android:fillColor="#00000000"
        android:strokeColor="#F54ADE9E"
        android:strokeWidth="6.5" />

    <!-- 荧光糖珠 -->
    <path android:pathData="M54,54 m-9.5,0 a9.5,9.5 0 1,1 19,0 a9.5,9.5 0 1,1 -19,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="51.6"
                android:centerY="49.8"
                android:gradientRadius="11">
                <item android:offset="0" android:color="#FFD6FBEF" />
                <item android:offset="0.4" android:color="#FF6FE6B2" />
                <item android:offset="0.75" android:color="#FF2FB683" />
                <item android:offset="1" android:color="#FF22A173" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 底部微反光 -->
    <path
        android:pathData="M49.5,59.8 a4.5,2.2 0 1,0 9,0 a4.5,2.2 0 1,0 -9,0"
        android:fillColor="#597CE8BC" />
</vector>
