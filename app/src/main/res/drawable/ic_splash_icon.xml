<?xml version="1.0" encoding="utf-8"?>
<!-- 开屏图标（系统 SplashScreen API）：不透明自包含「深夜绿砖」，内容占比与启动图标同步 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 砖体底（135° 渐变，与启动图标一致） -->
    <path android:pathData="M0,0 h108 v108 h-108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0" android:color="#FF1D3F2F" />
                <item android:offset="1" android:color="#FF102B1F" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 外涟漪（弱） -->
    <path
        android:pathData="M54,54 m-32,0 a32,32 0 1,1 64,0 a32,32 0 1,1 -64,0"
        android:fillColor="#00000000"
        android:strokeColor="#994ADE9E"
        android:strokeWidth="5.5" />

    <!-- 内涟漪（强） -->
    <path
        android:pathData="M54,54 m-22.5,0 a22.5,22.5 0 1,1 45,0 a22.5,22.5 0 1,1 -45,0"
        android:fillColor="#00000000"
        android:strokeColor="#EB4ADE9E"
        android:strokeWidth="8" />

    <!-- 荧光糖珠 -->
    <path android:pathData="M54,54 m-12,0 a12,12 0 1,1 24,0 a12,12 0 1,1 -24,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="51.1"
                android:centerY="49.7"
                android:gradientRadius="13.5">
                <item android:offset="0" android:color="#FFB8F6DE" />
                <item android:offset="0.45" android:color="#FF57D9A4" />
                <item android:offset="0.8" android:color="#FF23A876" />
                <item android:offset="1" android:color="#FF1E9468" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
