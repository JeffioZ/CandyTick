<?xml version="1.0" encoding="utf-8"?>
<!-- 开屏专用图标：透明底薄荷环 + 糖珠（无日夜变体，深绿开屏底上两态一致且沉浸） -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 外涟漪 -->
    <path
        android:pathData="M54,54 m-29,0 a29,29 0 1,1 58,0 a29,29 0 1,1 -58,0"
        android:fillColor="#00000000"
        android:strokeColor="#994ADE9E"
        android:strokeWidth="5" />

    <!-- 内涟漪（强） -->
    <path
        android:pathData="M54,54 m-20.5,0 a20.5,20.5 0 1,1 41,0 a20.5,20.5 0 1,1 -41,0"
        android:fillColor="#00000000"
        android:strokeColor="#F54ADE9E"
        android:strokeWidth="7.5" />

    <!-- 荧光糖珠 -->
    <path android:pathData="M54,54 m-11,0 a11,11 0 1,1 22,0 a11,11 0 1,1 -22,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="51.4"
                android:centerY="50"
                android:gradientRadius="12.5">
                <item android:offset="0" android:color="#FFD6FBEF" />
                <item android:offset="0.4" android:color="#FF6FE6B2" />
                <item android:offset="0.75" android:color="#FF2FB683" />
                <item android:offset="1" android:color="#FF22A173" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
